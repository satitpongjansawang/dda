# Document Search Configuration
# AUTO_NO_CHR: Document prefix for normal mode (e.g., 'ITSEQ')
# AUTO_NO: Specific document number for recovery mode (e.g., 'ITSEQ-2601-00002')
#          Leave empty to use normal mode with AUTO_NO_CHR
AUTO_NO_CHR=ITSEQ
AUTO_NO=

# File Path Configuration
BASE_FILE_PATH=C:\Myapp\DASY-FLII\WEB-INF\AppendFiles

# Google Drive Configuration (for sql_to_gdrive.py)
SERVICE_ACCOUNT_FILE=C:\DASY-ETL\dda\prj-nt-th-hub-117066b23d50.json
GOOGLE_DRIVE_FOLDER_ID=1t-iToHHsud8uZVer_W9K7slmel-clySw

# Google Drive to Windows Folder Configuration (for gdrive_to_wfolder.py)
# GDRIVE_SOURCE_FOLDER_ID: Google Drive folder ID to download files from
GDRIVE_SOURCE_FOLDER_ID=your_source_folder_id
# DESTINATION_FOLDER_PATH: Local Windows folder path to save downloaded files
DESTINATION_FOLDER_PATH=C:\Downloads\FromGDrive
# TRANSFER_MODE: 'copy' (keep files in GDrive) or 'move' (delete from GDrive after download)
TRANSFER_MODE=copy
# FILE_EXTENSIONS_FILTER: Optional comma-separated extensions to filter (e.g., .pdf,.xlsx)
FILE_EXTENSIONS_FILTER=

# XLSM to CSV Configuration (for gdrive_xlsm_to_csv_wfolder.py)
# CSV_DESTINATION_FOLDER: Local Windows folder path to save converted CSV files
CSV_DESTINATION_FOLDER=C:\Downloads\CSV_Output
# XLSM_TRANSFER_MODE: 'copy' (keep files in GDrive) or 'move' (delete from GDrive after conversion)
XLSM_TRANSFER_MODE=copy
# KEEP_XLSM: Keep the downloaded .xlsm file after conversion (true/false)
KEEP_XLSM=false
# CSV_ENCODING: Encoding for CSV output (utf-8-sig recommended for Excel compatibility)
CSV_ENCODING=utf-8-sig
# XLSM_SHEET_NAME: Name of sheet to convert (leave empty for first sheet)
XLSM_SHEET_NAME=
